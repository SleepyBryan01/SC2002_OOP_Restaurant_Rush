@startuml usecase
!include style.iuml
skinparam actorStyle awesome
title Use case diagram - Restaurant Rush (final design, tag stage-3)
left to right direction

actor "Manager\n(player)" as Manager

rectangle "Restaurant Rush" {
  usecase "Play a game\n(18 turns)" as UC_Game
  usecase "Replay a recorded run\n(commands from a script file)" as UC_Replay
  usecase "Read the rules\nand targets" as UC_Rules
  usecase "See the result\n(Victory or Defeat)" as UC_Result

  usecase "Play a turn" as UC_Turn
  usecase "Review the\nrestaurant board" as UC_Board
  usecase "Run the automatic steps\n(arrival, eating, payment,\npatience and abandonment)" as UC_Auto
  usecase "Show help" as UC_Help
  usecase "Reject an invalid choice\nand ask again" as UC_Reject

  usecase "Direct the Waiter" as UC_Waiter
  usecase "Seat a customer" as UC_Seat
  usecase "Take an order\n(customer picks the dish,\nprice is locked)" as UC_Order
  usecase "Serve a READY dish" as UC_Serve
  usecase "Direct the Chef\n(cook one unit)" as UC_Chef

  usecase "Apply VIP discount" as UC_VIP STAGE2
  usecase "Critic reacts\nto cold food" as UC_Critic STAGE2

  usecase "Direct the Host" as UC_Host STAGE3
  usecase "Switch on Happy Hour" as UC_Happy STAGE3
  usecase "Apply Happy Hour price" as UC_HappyPrice STAGE3
}

Manager --> UC_Game

UC_Game ..> UC_Rules : <<include>>
UC_Game ..> UC_Turn : <<include>>
UC_Game ..> UC_Result : <<include>>
UC_Replay ..> UC_Game : <<extend>>\n[script file given]

UC_Turn ..> UC_Board : <<include>>
UC_Turn ..> UC_Waiter : <<include>>
UC_Turn ..> UC_Chef : <<include>>
UC_Turn ..> UC_Auto : <<include>>
UC_Host ..> UC_Turn : <<extend>>
UC_Happy ..> UC_Turn : <<extend>>\n[turn start, not yet used]
UC_Help ..> UC_Turn : <<extend>>\n[types help]
UC_Reject ..> UC_Turn : <<extend>>\n[choice not allowed]

UC_Waiter <|-- UC_Seat
UC_Waiter <|-- UC_Order
UC_Waiter <|-- UC_Serve
UC_Host ..> UC_Seat : <<include>>

UC_VIP ..> UC_Order : <<extend>>\n[customer is VIP]
UC_HappyPrice ..> UC_Order : <<extend>>\n[Happy Hour active]
UC_Critic ..> UC_Serve : <<extend>>\n[customer is Critic]

legend top right
  <b>Key</b>
  <back:#EAF2FB>  Stage 1  </back>   <back:#FFCC80>  added in Stage 2  </back>   <back:#A5D6A7>  added in Stage 3  </back>
  One actor: a marker replaying a script plays the same Manager role;
  only the source of the commands changes (Replay extends Play a game).
  Arrivals, eating, the Cashier's payment and abandonment are steps the
  system runs inside every turn, so they are included, not actors.
endlegend
@enduml
