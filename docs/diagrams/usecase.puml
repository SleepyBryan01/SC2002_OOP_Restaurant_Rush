@startuml usecase
!include style.iuml
skinparam actorStyle awesome
skinparam usecaseFontSize 12
title Use case diagram - Restaurant Rush (final design, tag stage-3)
left to right direction

actor "Manager\n(player)" as Manager

rectangle "Restaurant Rush  (command-line game, base setting)" {
  usecase "Replay a recorded run\n(commands read from a script file)" as UC_Replay
  usecase "Play a game\n(18 turns, no early ending)" as UC_Game
  usecase "View rules, menu\nand targets" as UC_Rules
  usecase "View final result\n(Victory or Defeat)" as UC_Result
  usecase "Switch on Happy Hour\n(once per game,\nlasts 2 turns)" as UC_Happy STAGE3
  usecase "Show help" as UC_Help
  usecase "Explain invalid choice\nand ask again\n(task not used up)" as UC_Reject
  usecase UC_Turn as "Play a turn
  --
  <i>extension points</i>
  turn start
  staff choice"
  usecase "View start-of-turn status\n(revenue, queue, tables,\nsatisfaction, orders, tasks)" as UC_Status
  usecase "Assign Host task\n(seat one queued customer)" as UC_Host STAGE3
  usecase "Assign Waiter task\n(at most one per turn)" as UC_Waiter
  usecase "Assign Chef task\n(advance one order\nby one unit)" as UC_Chef
  usecase "Resolve automatic steps\n(arrival, eating, Cashier payment,\nsatisfaction loss, abandonment)" as UC_Auto
  usecase "View end-of-turn results\n(served, departures, revenue,\naverage or N/A, turns used)" as UC_End
  usecase "Seat a queued customer\nat a free table" as UC_Seat
  usecase "Take a seated\ncustomer's order" as UC_Order
  usecase "Serve an order that was\nREADY before this turn" as UC_Serve
  usecase "Let the staff\nmember wait" as UC_Wait
  usecase "Customer chooses\nown food\n(documented rule)" as UC_Choose
  usecase "Pick a ComboMeal\n(two items, 90% price,\nsummed units)" as UC_Combo STAGE3
  usecase "Apply VIP discount\n(10% off)" as UC_VIP STAGE2
  usecase "Apply Happy Hour\ndiscount (20% off,\nafter VIP)" as UC_HappyPrice STAGE3
  usecase "Critic reacts\nto cold food" as UC_Critic STAGE2
}

Manager --> UC_Game
UC_Replay ..> UC_Game : <<extend>>\n[script file given]
UC_Game ..> UC_Rules : <<include>>
UC_Game ..> UC_Turn : <<include>>
UC_Game ..> UC_Result : <<include>>
UC_Happy ..> UC_Turn : <<extend>>\n(turn start)\n[not used yet]
UC_Help ..> UC_Turn : <<extend>>\n(staff choice)\n[manager types help]
UC_Reject ..> UC_Turn : <<extend>>\n(staff choice)\n[choice not allowed]
UC_Turn ..> UC_Status : <<include>>
UC_Turn ..> UC_Host : <<include>>
UC_Turn ..> UC_Waiter : <<include>>
UC_Turn ..> UC_Chef : <<include>>
UC_Turn ..> UC_Auto : <<include>>
UC_Turn ..> UC_End : <<include>>
UC_Host ..> UC_Seat : <<include>>
UC_Waiter <|-- UC_Seat
UC_Waiter <|-- UC_Order
UC_Waiter <|-- UC_Serve
UC_Waiter <|-- UC_Wait
UC_Order ..> UC_Choose : <<include>>
UC_Combo ..> UC_Choose : <<extend>>\n[rule selects a combo]
UC_VIP ..> UC_Order : <<extend>>\n[customer is VIP]
UC_HappyPrice ..> UC_Order : <<extend>>\n[Happy Hour active]
UC_Critic ..> UC_Serve : <<extend>>\n[customer is a Critic]

legend top left
  <b>Key</b>
  <back:#EAF2FB>  Stage 1  </back>   <back:#FFCC80>  added in Stage 2  </back>   <back:#A5D6A7>  added in Stage 3  </back>
  <b>One actor.</b> An actor is a role: a marker replaying a script plays the
  Manager role; only the source of the commands changes.
  The Cashier, arrivals and abandonment run automatically inside every turn,
  so they are use cases the turn includes, not actors.
  Every staff task (Host, Waiter, Chef) can also be Wait.
  Brief 3.2: status = 3.1, staff tasks = step 2, automatic steps = steps 1, 3-5,
  end-of-turn results = 3.5, final result = step 6.
  During Happy Hour, waiting customers recover 15 at turn start (automatic).
  Prices are locked when the order is taken (VIP first, then Happy Hour).
endlegend
@enduml
